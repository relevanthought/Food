# Local dev: matches docker-compose.yml (`docker compose up -d`).
# Production: use your hosted Postgres connection string (Vercel Postgres,
# Neon, Supabase, etc.) — see the "Deploying" section in the README.
DATABASE_URL="postgresql://forkcast:forkcast_dev_password@localhost:5432/forkcast"

# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Optional — only needed for `npm run google:lookup`. Get one at
# https://console.cloud.google.com/apis/credentials with "Places API (New)"
# enabled on the project.
GOOGLE_PLACES_API_KEY=""
