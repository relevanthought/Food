// Prisma schema for the dish rating & recommendation app.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ReviewSource {
  GOOGLE
  YELP
  OPENTABLE
  TRIPADVISOR
}

enum SocialPlatform {
  X
  INSTAGRAM
  TIKTOK
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  cuisine   String
  city      String
  address   String
  priceTier Int // 1-4, like $ to $$$$
  imageUrl  String
  dishes    Dish[]
  createdAt DateTime @default(now())

  // Real data from Google Places (Places API "New"), when this restaurant
  // has been linked to a real place. Null for the seeded demo restaurants.
  googlePlaceId         String?            @unique
  googleMapsUri         String?
  googleRating          Float?
  googleUserRatingCount Int?
  googleSyncedAt        DateTime?
  googleReviews         RestaurantReview[]
}

// Real restaurant-level reviews pulled from Google Places. Kept separate
// from `Review` (which is per-dish and, for now, entirely mock-generated —
// Google/Yelp/etc. don't expose per-dish review data).
model RestaurantReview {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  authorName   String
  rating       Int
  text         String
  relativeTime String // Google's human-readable "2 months ago"
  publishedAt  DateTime

  @@index([restaurantId])
}

model Dish {
  id           String          @id @default(cuid())
  name         String
  description  String
  category     String // e.g. Appetizer, Entree, Dessert, Drink
  price        Float
  imageUrl     String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  reviews      Review[]
  mentions     SocialMention[]
  favorites    Favorite[]
  createdAt    DateTime        @default(now())

  @@index([restaurantId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  favorites    Favorite[]
  createdAt    DateTime   @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId    String
  createdAt DateTime @default(now())

  @@unique([userId, dishId])
  @@index([dishId])
}

model Review {
  id          String       @id @default(cuid())
  dish        Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId      String
  source      ReviewSource
  authorName  String
  rating      Int // 1-5
  text        String
  publishedAt DateTime

  @@index([dishId])
}

model SocialMention {
  id           String         @id @default(cuid())
  dish         Dish           @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId       String
  platform     SocialPlatform
  authorHandle String
  caption      String
  url          String
  likeCount    Int
  commentCount Int
  shareCount   Int // shares on X/IG, or share-equivalent (saves) on TikTok
  viewCount    Int
  sentiment    Sentiment
  postedAt     DateTime

  @@index([dishId])
}
